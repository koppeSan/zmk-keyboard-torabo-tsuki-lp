#include "unicode.h"
#include "keycode_japanese.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv {
};

&msc {
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <57 41>;
            layers = <4>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <57 60>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none                        &none                &none             &none         &none                                                 &none            &none  &none      &none             &none                &none
&none  &mt ESC Q                    &kp W                &kp E             &kp R         &kp T                                                 &kp Y            &kp U  &kp I      &kp O             &kp P                &none
&none  &kp A                        &kp S                &kp D             &kp F         &kp G                 &none              &none        &kp H            &kp J  &kp K      &kp L             &lt 1 MINUS          &none
&none  &kp Z                        &kp X                &kp C             &kp V         &kp B                 &lt 4 PRINTSCREEN  &tog 1       &kp N            &kp M  &kp COMMA  &kp DOT           &kp SLASH            &none
&none  &mt LEFT_SHIFT LEFT_BRACKET  &lt 3 RIGHT_BRACKET  &mt LALT AT_SIGN  &kp LEFT_GUI  &mt LEFT_SHIFT GRAVE  &mt LCTRL SPACE    &lt 2 ENTER  &lt 3 BACKSPACE  &none  &none      &mt ESCAPE COLON  &mt RIGHT_ALT CARET  &none
            >;
        };

        Mouse {
            bindings = <
&trans  &trans                            &trans         &trans         &trans                &trans                                &trans     &trans          &trans          &trans           &trans             &trans
&trans  &kp C_NEXT                        &none          &kp C_BRI_DEC  &kp C_BRI_AUTO        &kp C_BRIGHTNESS_INC                  &mkp MB3   &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_RIGHT  &mt HOME PAGE_UP   &trans
&trans  &kp C_PLAY_PAUSE                  &kp C_AC_BACK  &kp C_AC_HOME  &kp C_AL_SELECT_TASK  &none                 &trans  &trans  &mkp MCLK  &mkp LCLK       &mkp RCLK       &kp LEFT_ARROW   &mt END PAGE_DOWN  &trans
&trans  &kp C_PREVIOUS                    &none          &kp C_VOL_DN   &kp K_MUTE            &kp C_VOLUME_UP       &trans  &tog 0  &mkp MB5   &mkp MB4        &msc SCRL_DOWN  &kp RIGHT        &trans             &trans
&trans  &mt LEFT_SHIFT C_AL_TASK_MANAGER  &trans         &trans         &trans                &trans                &trans  &trans  &trans     &trans          &trans          &trans           &trans             &trans
            >;

            label = "mouse";
        };

        Num_Sym {
            bindings = <
&trans  &trans         &trans             &trans          &trans                &trans                                    &trans           &trans  &trans  &trans     &trans        &trans
&trans  &kp NUMBER_1   &kp NUMBER_2       &kp NUMBER_3    &kp NUMBER_4          &kp N5                                    &kp NUMBER_6     &kp N7  &kp N8  &kp N9     &kp N0        &trans
&trans  &kp LS(EXCL)   &kp DOUBLE_QUOTES  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &trans       &trans     &kp PLUS         &kp N4  &kp N5  &kp N6     &kp MINUS     &trans
&trans  &kp LS(QMARK)  &kp AT             &kp PIPE        &kp COLON             &kp CARET         &kp INT_YEN  &kp KP_N0  &mt ENTER EQUAL  &kp N1  &kp N2  &kp N3     &kp SLASH     &trans
&trans  &trans         &trans             &trans          &trans                &mo 5             &kp LCTRL    &trans     &kp BACKSPACE    &trans  &trans  &kp CARET  &kp ASTERISK  &trans
            >;
        };

        Func_Txt {
            bindings = <
&trans  &trans       &trans  &trans   &trans   &trans                           &trans     &trans     &trans    &trans     &trans    &trans
&trans  &none        &kp F1  &kp F2   &kp F3   &kp F4                           &none      &kp PG_UP  &kp UP    &none      &kp HOME  &trans
&trans  &kp TAB      &kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans          &kp HOME   &kp LEFT   &kp DOWN  &kp RIGHT  &kp END   &trans
&trans  &kp LS(TAB)  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &kp LEFT_ARROW  &kp RIGHT  &kp PG_DN  &kp DOWN  &none      &trans    &trans
&trans  &trans       &trans  &trans   &trans   &trans   &trans  &trans          &trans     &trans     &trans    &trans     &trans    &trans
            >;
        };

        BT_ctrl {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_PRV    &bt BT_NXT    &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &bt BT_CLR    &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        shft_SYM {
            bindings = <
&trans  &trans        &trans            &trans           &trans                 &trans                                &trans           &trans         &trans        &trans                &trans                 &trans
&trans  &kp EXCL      &kp AT            &kp HASH         &kp DOLLAR             &kp PERCENT                           &kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp LS(EXCL)  &kp SINGLE_QUOTE  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &trans  &trans     &kp PLUS         &kp DOLLAR     &kp PERCENT   &kp CARET             &kp UNDERSCORE         &trans
&trans  &kp LCTRL     &kp AT            &kp BACKSLASH    &kp COLON              &kp TILDE          &trans  &kp KP_N0  &mt ENTER EQUAL  &kp EXCL       &kp AT        &kp HASH              &kp PIPE               &trans
&trans  &trans        &trans            &trans           &trans                 &trans             &trans  &trans     &kp BACKSPACE    &trans         &trans        &kp TILDE             &kp ASTERISK           &trans
            >;
        };
    };
};
