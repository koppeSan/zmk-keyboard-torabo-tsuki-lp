// =========================================================================
// ① ヘッダーファイルの読み込み
// =========================================================================
#include "unicode.h"
#include "keycode_japanese.h"
#include <input/processors.dtsi>       // ZMK標準のInput Processor（入力変換）機能
#include <behaviors.dtsi>              // ホールドやタップなどのキー挙動機能
#include <dt-bindings/zmk/bt.h>        // Bluetooth制御用のキーコード
#include <dt-bindings/zmk/keys.h>      // 一般的なキーコード
#include <dt-bindings/zmk/pointing.h>  // マウスクリックなどのポインティング用キーコード
// ↓【追加】X軸（INPUT_REL_X）やホイールなどの入力イベントのコードを認識させるために必須
#include <zephyr/dt-bindings/input/input-event-codes.h> 

// =========================================================================
// ② マウスエミュレーション（移動・スクロール）の基本設定
// =========================================================================
&mmv { }; // カーソル移動（Mouse Move）の設定（今回はデフォルト）

&msc {
    // スクロール（Mouse Scroll）の動作感の調整
    acceleration-exponent = <1>; // 加速度の強さ（1は一定加速度）
    time-to-max-speed-ms = <400>; // 最高速度に達するまでの時間（ミリ秒）
    delay-ms = <0>; // 入力してから動き出すまでの遅延
};

// =========================================================================
// ③ トラックボールの入力を監視・加工するリスナー（🌟今回の最重要部分）
// ここに並べた input-processors が「上から順番に」実行されます。
// =========================================================================
&trackball_listener {
    input-processors = 
        // 処理1: レイヤー7の時だけ、横方向(X軸)の動きを 0倍(無効化) にする
        // これがないと、上下に転がした時に横スクロールも混ざってしまいます。
        <&layer7_x_zero 0 1>,

        // 処理2: レイヤー7の時だけ、残った動き(Y軸)をスクロールに変換する
        // 処理1を通過したY軸の動きだけがここで変換され、縦スクロールになります。
        <&layer7_scroll>,

        // 処理3: ボールが動いたら、Layer 1（マウスレイヤー）を10000ミリ秒(10秒間)有効にする
        // これが「オートマウスレイヤー（AML）」の本体です。
        // Layer 7以外では処理1と2が無視されるため、通常時はこれだけが発動します。
        // Layer 7の時も、処理1と2で「process-next」を指定しているため、ここまで到達してAMLが維持されます。
        <&zip_temp_layer 1 10000>;
};

/ {
    // =====================================================================
    // ④ カスタム Input Processor の定義（オリジナルルールの作成）
    // =====================================================================

    // ルールA：レイヤー7専用の「横移動を無効化する」プロセッサ
    layer7_x_zero: layer7_x_zero {
        compatible = "zmk,input-processor-scaler"; // 数値を拡大/縮小する機能を使用
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>; // カーソル移動などの「相対移動イベント」を対象
        codes = <INPUT_REL_X>; // X軸（左右の動き）のみを対象とする
        layers = <7>;          // ★Layer 7が有効な時だけ発動させる
        process-next;          // ★【重要】処理をここで止めず、次のスクロール変換へ引き継ぐ
    };

    // ルールB：レイヤー7専用の「カーソル移動をスクロールに変換する」プロセッサ
    layer7_scroll: layer7_scroll {
        compatible = "zmk,input-processor-code-mapper"; // 別の入力イベントに変換する機能を使用
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>; 
        // X軸を横ホイールに、Y軸を縦ホイールに変換するという指定
        // （直前のルールAでX軸は0にされているため、実質Y軸＝縦ホイールだけが発動します）
        map = <INPUT_REL_X INPUT_REL_HWHEEL>, <INPUT_REL_Y INPUT_REL_WHEEL>;
        layers = <7>;          // ★Layer 7が有効な時だけ発動させる
        process-next;          // ★【重要】処理をここで止めず、次のAML更新へ引き継ぐ
    };

    // =====================================================================
    // ⑤ 既存のコンボ、マクロ、ビヘイビアの設定
    // =====================================================================
    combos {
        compatible = "zmk,combos";
        bt_clear {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <57 41>;
            layers = <5>;
        };
    };

    macros {
        // Lキー専用マクロ：レイヤー8への切り替えとAlt保持を同時に行う
        l_nav: l_nav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press>, <&mo 8 &kp LALT>, <&macro_pause_for_release>, <&macro_release>, <&mo 8 &kp LALT>; // Lキーを離したら、Layer 8とLALTを解放
        };
        // Jキー（Ctrl+Tab）用マクロ：Altが干渉しないように一時的に解放する
        tab_next: tab_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release>, <&kp LALT &kp LC(TAB)>, <&macro_press>, <&kp LALT>; // 再びAltを押し直す
        };
        // Kキー（Ctrl+Shift+Tab）用マクロ
        tab_prev: tab_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release>, <&kp LALT &kp LC(LS(TAB))>, <&macro_press>, <&kp LALT>;
        };
    };

    // カスタム挙動の定義部屋（単打と長押しの分岐）
    behaviors {
        ht_l_nav: hold_tap_l_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred"; // タップ（単打）を優先
            tapping-term-ms = <200>; // 200ms長押しでマクロ発動
            bindings = <&l_nav>, <&kp>;
        };
    };

    // =====================================================================
    // ⑥ キーマップ本体
    // =====================================================================
    keymap {
        compatible = "zmk,keymap";

        // Layer 0 default (基本となるレイヤー)
        default {
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none &none &mt ESC Q 
                &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &none &none &kp A &kp S &kp D &kp F &kp G 
                &none &none &kp H &kp J &kp K &kp L &lt 7 JP_MINUS &none &none &kp Z &kp X &kp C &kp V &kp B 
                &lt 5 PRINTSCREEN &lt 8 INT5 &kp N &kp M &kp JP_COMMA &kp JP_DOT &lt 1 JP_SLASH &none &none &lt 2 INT5 
                &lt 4 JP_AT &mt LALT JP_ZKHK &kp LEFT_GUI &mt LEFT_SHIFT INT4 &mt LCTRL SPACE &lt 4 ENTER &lt 3 BACKSPACE &none &none &mt ESCAPE JP_CARET &mt RIGHT_ALT JP_SEMI &none
            >;
        };

        // Layer 1 Mouse (オートマウス機能で自動的に切り替わるレイヤー)
        Mouse {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp C_NEXT 
                // ここにある「&mo 7」を押している間はLayer 7（スクロールレイヤー）になります
                &none &kp C_BRI_DEC &kp C_BRI_AUTO &kp C_BRIGHTNESS_INC &mo 7 &msc SCRL_LEFT &msc SCRL_UP &msc SCRL_RIGHT &mt HOME PAGE_UP &trans &trans &kp C_PLAY_PAUSE &none &none &kp C_AL_SELECT_TASK &none 
                &trans &trans &mkp MCLK &mkp LCLK &mkp RCLK &mkp MB3 &mt END PAGE_DOWN &trans &trans &kp C_PREVIOUS &none &kp C_VOL_DN &kp K_MUTE &kp C_VOLUME_UP &trans &to 0 
                &mkp MB5 &mkp MB4 &msc SCRL_DOWN &kp RIGHT &trans &trans &trans &mt LEFT_SHIFT C_AL_TASK_MANAGER &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            label = "mouse";
        };

        // Layer 2 DELKEY
        DELKEY {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans 
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans 
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp JP_UNDER &trans &trans &trans &trans &trans &trans 
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp DEL &trans &trans &trans &trans &trans
            >;
        };

        // Layer 3 Num_Sym
        Num_Sym {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp TILDE 
                &kp JP_SQT &kp JP_LBRC &kp JP_RBRC &kp JP_SEMI &kp TAB &kp N7 &kp N8 &kp N9 &kp JP_ASTRK &trans &trans &kp JP_EXCL &kp JP_DQT &kp JP_LPAR &kp JP_RPAR &kp JP_COLON 
                &trans &trans &kp JP_PLUS &kp N4 &kp N5 &kp N6 &kp JP_MINUS &trans &trans &kp JP_QMARK &kp JP_GRAVE &kp JP_LBKT &kp JP_RBKT &kp JP_YEN &trans &kp N0 
                &mt JP_EQUAL N0 &kp N1 &kp N2 &kp N3 &kp JP_SLASH &trans &trans &trans &trans &trans &trans &trans &mo 6 &kp LCTRL &trans &kp BACKSPACE &trans &trans &kp JP_CARET &kp JP_PIPE
            >;
        };

        // Layer 4 Func_Txt
        Func_Txt {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &none 
                &kp F1 &kp F2 &kp F3 &kp F4 &none &kp PG_UP &kp UP &none &kp HOME &trans &trans &kp TAB &kp F5 &kp F6 &kp F7 &kp F8 
                &trans &trans &kp HOME &kp LEFT &kp DOWN &kp RIGHT &kp JP_UNDER &trans &trans &kp LS(TAB) &kp F9 &kp F10 &kp F11 &kp F12 &trans &kp LEFT_ARROW 
                &kp RIGHT &kp PG_DN &kp END &none &kp JP_PIPE &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        // Layer 5 BT_ctrl
        BT_ctrl {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &bt BT_NXT 
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &trans &trans &trans &trans &trans &trans &trans &bt BT_PRV &bt BT_SEL 4 &bt BT_SEL 5 &bt BT_SEL 6 &bt BT_SEL 7 
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &bt BT_CLR &trans &trans &trans &trans 
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        // Layer 6 shft_SYM
        shft_SYM {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp JP_TILDE 
                &kp JP_AT &kp JP_LBRC &kp JP_RBRC &kp JP_SEMI &kp JP_CARET &kp JP_AMPS &kp JP_ASTRK &kp JP_LPAR &kp JP_CARET &trans &trans &kp JP_EXCL &kp JP_SQT &kp JP_LPAR &kp JP_RPAR &kp JP_COLON 
                &trans &trans &kp JP_PLUS &kp JP_DLLR &kp JP_PRCNT &kp JP_CARET &kp JP_UNDER &trans &trans &kp JP_CARET &kp JP_GRAVE &kp JP_LBKT &kp JP_RBKT &kp JP_BSLH &trans &kp KP_N0 
                &mt ENTER JP_EQUAL &kp JP_EXCL &kp JP_AT &kp JP_HASH &kp JP_PRCNT &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp BACKSPACE &trans &trans &kp JP_TILDE &kp JP_PIPE &trans
            >;
        };

        // Layer 7 scrollL (縦スクロールを有効にするためのレイヤー)
        scrollL {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans 
                &trans &trans &trans &trans &trans &kp LA(TAB) &kp LS(LA(TAB)) &trans &trans &trans &trans &trans &trans &trans &trans &trans 
                &trans &trans &trans &kp LC(TAB) &kp LC(LS(TAB)) &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans 
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        // Layer 8 (nav_layer)
        nav_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans 
                &trans &trans &trans &trans &kp TAB &kp LS(TAB) &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans 
                &trans &trans &tab_next &tab_prev &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans 
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
```
