#include "unicode.h"
#include "keycode_japanese.h"
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv {
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <400>;
    delay-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <57 41>;
            layers = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&none  &none          &none          &none           &none         &none                                                 &none            &none  &none         &none                &none                   &none
&none  &mt ESC Q      &kp W          &kp E           &kp R         &kp T                                                 &kp Y            &kp U  &kp I         &kp O                &kp P                   &none
&none  &kp A          &kp S          &kp D           &kp F         &kp G                 &none              &none        &kp H            &kp J  &kp K         &kp L                &kp JP_MINUS            &none
&none  &kp Z          &kp X          &kp C           &kp V         &kp B                 &lt 5 PRINTSCREEN  &to 1        &kp N            &kp M  &kp JP_COMMA  &kp JP_DOT           &lt 1 JP_SLASH          &none
&none  &lt 2 JP_LBKT  &lt 4 JP_RBKT  &mt LALT JP_AT  &kp LEFT_GUI  &mt LEFT_SHIFT JP_ZKHK  &mt LCTRL SPACE    &lt 3 ENTER  &lt 4 BACKSPACE  &none  &none         &mt ESCAPE JP_COLON  &mt RIGHT_ALT JP_CARET  &none
            >;
        };

        Mouse {
            bindings = <
&trans  &trans                            &trans         &trans         &trans                &trans                                &trans     &trans          &trans          &trans           &trans             &trans
&trans  &kp C_NEXT                        &none          &kp C_BRI_DEC  &kp C_BRI_AUTO        &kp C_BRIGHTNESS_INC                  &mo 7      &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_RIGHT  &mt HOME PAGE_UP   &trans
&trans  &kp C_PLAY_PAUSE                  &kp C_AC_BACK  &kp C_AC_HOME  &kp C_AL_SELECT_TASK  &none                 &trans  &trans  &mkp MCLK  &mkp LCLK       &mkp RCLK       &kp LEFT_ARROW   &mt END PAGE_DOWN  &trans
&trans  &kp C_PREVIOUS                    &none          &kp C_VOL_DN   &kp K_MUTE            &kp C_VOLUME_UP       &trans  &to 0   &mkp MB5   &mkp MB4        &msc SCRL_DOWN  &kp RIGHT        &trans             &trans
&trans  &mt LEFT_SHIFT C_AL_TASK_MANAGER  &trans         &trans         &trans                &trans                &trans  &trans  &trans     &trans          &trans          &trans           &trans             &trans
            >;

            label = "mouse";
        };

        DELKEY {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DEL  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Num_Sym {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                               &trans              &trans  &trans  &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                               &kp NUMBER_6        &kp N7  &kp N8  &kp N9        &kp N0        &trans
&trans  &kp JP_EXCL   &kp JP_DQT    &kp JP_LBRC   &kp JP_LPAR   &kp JP_LBKT   &trans      &trans     &kp JP_PLUS         &kp N4  &kp N5  &kp N6        &kp JP_MINUS  &trans
&trans  &kp JP_QMARK  &kp JP_YEN    &kp JP_PIPE   &kp JP_COLON  &kp JP_CARET  &kp JP_YEN  &kp KP_N0  &mt JP_EQUAL KP_N0  &kp N1  &kp N2  &kp N3        &kp JP_SLASH  &trans
&trans  &trans        &trans        &trans        &trans        &mo 6         &kp LCTRL   &trans     &kp BACKSPACE       &trans  &trans  &kp JP_CARET  &kp JP_ASTRK  &trans
            >;
        };

        Func_Txt {
            bindings = <
&trans  &trans       &trans  &trans   &trans   &trans                           &trans     &trans     &trans    &trans     &trans       &trans
&trans  &none        &kp F1  &kp F2   &kp F3   &kp F4                           &none      &kp PG_UP  &kp UP    &none      &kp HOME     &trans
&trans  &kp TAB      &kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans          &kp HOME   &kp LEFT   &kp DOWN  &kp RIGHT  &kp END      &trans
&trans  &kp LS(TAB)  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &kp LEFT_ARROW  &kp RIGHT  &kp PG_DN  &kp DOWN  &none      &kp JP_PIPE  &trans
&trans  &trans       &trans  &trans   &trans   &trans   &trans  &trans          &trans     &trans     &trans    &trans     &trans       &trans
            >;
        };

        BT_ctrl {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_NXT    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_PRV    &bt BT_SEL 4  &bt BT_SEL 5  &bt BT_SEL 6  &bt BT_SEL 7  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &bt BT_CLR    &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
     };

        shft_SYM {
            bindings = <
&trans  &trans        &trans        &trans       &trans       &trans                           &trans              &trans       &trans        &trans        &trans        &trans
&trans  &kp JP_EXCL   &kp JP_AT     &kp JP_HASH  &kp JP_DLLR  &kp JP_PRCNT                     &kp JP_CARET        &kp JP_AMPS  &kp JP_ASTRK  &kp JP_LPAR   &kp JP_RPAR   &trans
&trans  &kp JP_EXCL   &kp JP_SQT    &kp JP_RBRC  &kp JP_RPAR  &kp JP_RBKT   &trans  &trans     &kp JP_PLUS         &kp JP_DLLR  &kp JP_PRCNT  &kp JP_CARET  &kp JP_UNDER  &trans
&trans  &kp JP_CARET  &kp JP_GRAVE  &kp JP_BSLH  &kp JP_SEMI  &kp JP_TILDE  &trans  &kp KP_N0  &mt ENTER JP_EQUAL  &kp JP_EXCL  &kp JP_AT     &kp JP_HASH   &kp JP_PIPE   &trans
&trans  &trans        &trans        &trans       &trans       &trans        &trans  &trans     &kp BACKSPACE       &trans       &trans        &kp JP_TILDE  &kp JP_ASTRK  &trans
            >;
        };

        scrollL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
