#include "unicode.h"
#include "keycode_japanese.h"
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv {
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <400>;
    delay-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <57 41>;
            layers = <5>;
        };
    };
    
    macros {
        // Lキー専用マクロ：レイヤー8への切り替えとAlt保持を同時に行う
        l_nav: l_nav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 8 &kp LALT>
                , <&macro_pause_for_release>
                , <&macro_release &mo 8 &kp LALT>;
        };

        // Jキー（Ctrl+Tab）用マクロ
        tab_next: tab_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_release &kp LALT>
                , <&kp LC(TAB)>
                , <&macro_press &kp LALT>;
        };

        // Kキー（Ctrl+Shift+Tab）用マクロ
        tab_prev: tab_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_release &kp LALT>
                , <&kp LC(LS(TAB))>
                , <&macro_press &kp LALT>;
        };
    };

    behaviors {
        ht_l_nav: hold_tap_l_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&l_nav>, <&kp>; 
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0
        default {
            bindings =
