#include "unicode.h"
#include "keycode_japanese.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv {
};

&msc {
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <26 40 14>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none           &none     &none     &none                      &none                                                    &none            &none  &none      &none             &none          &none
&none  &mt ESCAPE Q    &kp W     &kp E     &kp R                      &kp T                                                    &kp Y            &kp U  &kp I      &kp O             &kp P          &none
&none  &mt TAB A       &kp S     &kp D     &kp F                      &kp G                      &none            &none        &kp H            &kp J  &kp K      &kp L             &kp MINUS      &none
&none  &kp Z           &kp X     &kp C     &kp V                      &kp B                      &lt 4 TAB        &kp DELETE   &kp N            &kp M  &kp COMMA  &kp DOT           &lt 1 FSLH     &none
&none  &kp LEFT_SHIFT  &lt 3 AT  &kp LALT  &mt LEFT_GUI C_AC_ZOOM_IN  &mt LEFT_SHIFT UNDERSCORE  &mt LCTRL SPACE  &lt 3 ENTER  &lt 2 BACKSPACE  &none  &none      &mt ESCAPE COLON  &kp RIGHT_ALT  &none
            >;
        };

        Mouse {
            bindings = <
&trans  &trans                            &trans  &trans          &trans             &trans                                 &trans     &trans          &trans          &trans           &trans             &trans
&trans  &kp C_NEXT                        &none   &kp C_NEXT      &kp K_MUTE         &kp C_BRIGHTNESS_AUTO                  &mkp MB3   &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_RIGHT  &mt HOME PAGE_UP   &trans
&trans  &kp C_PLAY_PAUSE                  &none   &kp C_AC_HOME   &kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC   &trans  &trans  &mkp MCLK  &mkp LCLK       &mkp RCLK       &kp LEFT_ARROW   &mt END PAGE_DOWN  &trans
&trans  &kp C_PREVIOUS                    &none   &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC   &trans  &trans  &mkp MB5   &mkp MB4        &msc SCRL_DOWN  &kp RIGHT        &trans             &trans
&trans  &mt LEFT_SHIFT C_AL_TASK_MANAGER  &trans  &trans          &trans             &trans                 &trans  &trans  &trans     &trans          &trans          &trans           &trans             &trans
            >;

            label = "mouse";
        };

        Num_Sym {
            bindings = <
&trans  &trans         &trans            &trans        &trans         &trans                                           &trans              &trans  &trans  &trans    &trans        &trans
&trans  &kp NUMBER_1   &kp NUMBER_2      &kp NUMBER_3  &kp NUMBER_4   &kp N5                                           &kp NUMBER_6        &kp N7  &kp N8  &kp N9    &kp N0        &trans
&trans  &kp LS(EXCL)   &kp SINGLE_QUOTE  &kp LBKT      &kp SEMICOLON  &kp LEFT_PARENTHESIS   &trans     &trans         &kp PLUS            &kp N4  &kp N5  &kp N6    &kp MINUS     &trans
&trans  &kp LS(QMARK)  &kp GRAVE         &kp RBKT      &kp BSLH       &kp RIGHT_PARENTHESIS  &trans     &kp LS(EQUAL)  &mt ENTER NUMBER_0  &kp N1  &kp N2  &kp N3    &kp SLASH     &trans
&trans  &trans         &trans            &trans        &trans         &kp LEFT_SHIFT         &kp LCTRL  &trans         &trans              &trans  &trans  &kp SEMI  &kp ASTERISK  &trans
            >;
        };

        Func_Txt {
            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans                   &trans    &trans     &trans    &trans     &trans      &trans
&trans  &none   &kp F1  &kp F2   &kp F3   &kp F4                   &none     &kp PG_UP  &kp UP    &kp HOME   &kp ESCAPE  &trans
&trans  &none   &kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans  &kp HOME  &kp LEFT   &kp DOWN  &kp RIGHT  &kp END     &trans
&trans  &none   &kp F9  &kp F10  &kp F11  &kp F12  &trans  &none   &none     &kp PG_DN  &kp DOWN  &none      &kp PIPE    &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans  &trans  &trans    &trans     &trans    &trans     &trans      &trans
            >;
        };

        BT_ctrl {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
